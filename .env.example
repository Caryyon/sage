# SAGE Discord Bot Environment Variables
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════
# Discord Bot Tokens - Multi-SAGE Support
# ═══════════════════════════════════════════════════════════════════════════
# Each SAGE instance needs its own Discord bot token.
# Create bots at: https://discord.com/developers/applications
#
# Required for Lumin (primary SAGE):
DISCORD_TOKEN=your_lumin_discord_token_here

# Optional - for additional SAGEs (use with docker compose --profile):
DISCORD_TOKEN_NOVA=your_nova_discord_token_here
DISCORD_TOKEN_ECHO=your_echo_discord_token_here

# ═══════════════════════════════════════════════════════════════════════════
# Job Instance Tokens (use with docker-compose.multi.yml)
# ═══════════════════════════════════════════════════════════════════════════
# These are role-specialized SAGE instances with expertise tracking.
# Each requires its own Discord bot token.
DISCORD_TOKEN_CONTENT=your_content_creator_token_here
DISCORD_TOKEN_ANALYST=your_data_analyst_token_here
DISCORD_TOKEN_SUPPORT=your_customer_support_token_here
DISCORD_TOKEN_MARKETER=your_ad_marketer_token_here

# ═══════════════════════════════════════════════════════════════════════════
# Ollama Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Use http://ollama:11434 when running in Docker (default)
# Use http://172.17.0.1:11434 to use host Ollama from Docker
OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════════════════════════════════════════
# SpacetimeDB Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Use http://spacetimedb:3000 when running in Docker (automatic)
# Use http://localhost:3001 when running locally (Docker maps 3001->3000)
SPACETIMEDB_URI=http://localhost:3001

# ═══════════════════════════════════════════════════════════════════════════
# Logging & Debug
# ═══════════════════════════════════════════════════════════════════════════
RUST_LOG=info
RUST_BACKTRACE=1

# ═══════════════════════════════════════════════════════════════════════════
# External API Integrations (Phase E)
# ═══════════════════════════════════════════════════════════════════════════
# These credentials enable SAGE job instances to interact with external services.
# All actions go through the human-in-loop approval system.
# Set SANDBOX_MODE=false to enable real API calls (requires valid credentials).

SANDBOX_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Facebook/Meta Graph API
# ─────────────────────────────────────────────────────────────────────────────
# Create an app at: https://developers.facebook.com/apps/
# Required permissions: pages_manage_posts, pages_read_engagement, pages_read_user_content
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics Data API
# ─────────────────────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable: Google Analytics Data API
# Download the service account JSON key file
GOOGLE_ANALYTICS_CREDENTIALS_FILE=/path/to/service-account-credentials.json
GOOGLE_ANALYTICS_PROPERTY_ID=properties/123456789

# ─────────────────────────────────────────────────────────────────────────────
# Zendesk API
# ─────────────────────────────────────────────────────────────────────────────
# Generate API token at: Admin > Channels > API
# https://your-subdomain.zendesk.com/admin/apps-integrations/apis/zendesk-api/settings
ZENDESK_SUBDOMAIN=your_subdomain
ZENDESK_EMAIL=your_email@example.com
ZENDESK_API_TOKEN=your_zendesk_api_token_here
