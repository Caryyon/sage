FROM rust:1.85-slim AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev nasm cmake g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
COPY benches/ benches/
RUN cargo build --release --bin miniworld_server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/miniworld_server /usr/local/bin/miniworld_server
COPY static/ /app/static/
WORKDIR /app
ENV RUST_LOG=info
EXPOSE 8888
CMD ["miniworld_server"]
