#!/bin/bash
# sage-speak - Send a message from Claude to SAGE via IRC
# Updated to use real IRC communication

if [ $# -eq 0 ]; then
    echo "Usage: ./sage-speak <message>"
    echo ""
    echo "Example: ./sage-speak 'Hi SAGE, how are you doing?'"
    exit 1
fi

MESSAGE="$*"

echo "💬 Claude → SAGE (via IRC #sage-ai)"
echo ""

# Use the claude_to_sage IRC messenger
cargo run --release --example claude_to_sage "$MESSAGE" 2>&1 | grep -v "Compiling\|Finished\|Running"
